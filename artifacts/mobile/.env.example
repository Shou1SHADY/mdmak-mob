# Firebase Configuration (required)
# Copy this file to .env and fill in your actual values.
# Get these values from your Firebase Console > Project Settings > General > Your apps > Web app.

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123def456

# API Server (optional — for local/self-hosted backend)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Sign-In (required for mobile Google auth)
# Get this from Firebase Console > Authentication > Sign-in method > Google > Web SDK configuration
# Looks like: XXXXXX.apps.googleusercontent.com
EXPO_PUBLIC_FIREBASE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
