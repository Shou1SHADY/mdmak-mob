# UAT Firebase config for the shared test build.
#
# These are the PUBLIC web-app config values — the same ones that ship inside
# every client bundle. They identify the project; they do not authorise anything.
# Access is controlled by firestore.rules and Firebase Auth, not by these.
# Retrieved with:
#   firebase apps:sdkconfig WEB <appId> --project mdmaktech-uat
#
# Used by `npm run build:web:uat`, which points the shared PWA at UAT so testers
# never touch production data. Without these, lib/firebase.ts falls back to the
# PRODUCTION project — which is exactly what a public test link must not do.

EXPO_PUBLIC_FIREBASE_PROJECT_ID=mdmaktech-uat
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyComlALEqelppL2K6n1H5_5dvPcn69064M
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=mdmaktech-uat.firebaseapp.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=mdmaktech-uat.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=265884033669
EXPO_PUBLIC_FIREBASE_APP_ID=1:265884033669:web:a3a488fc31d68c55227fec
