{
  "expo": {
    "name": "Mdmak Tech",
    "slug": "mdmak-tech",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mdmaktech",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-bg.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mdmaktech.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Mdmak Tech uses your camera to upload profile photos and product images.",
        "NSPhotoLibraryUsageDescription": "Mdmak Tech needs access to your photos to upload product images and profile pictures.",
        "NSLocationWhenInUseUsageDescription": "Mdmak Tech uses your location to connect you with nearby suppliers and contractors.",
        "NSFaceIDUsageDescription": "Mdmak Tech supports Face ID for secure authentication.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mdmaktech.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Mdmak Tech",
      "shortName": "Mdmak",
      "display": "standalone",
      "orientation": "portrait",
      "themeColor": "#0F172A",
      "backgroundColor": "#0F172A",
      "lang": "ar",
      "startUrl": "/",
      "description": "Mdmak Tech — B2B procurement for contractors and suppliers"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#20CBD5"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#20CBD5",
      "androidMode": "default"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
