# PRODUCTION Firebase config for the public PWA (mdmak-mobile.web.app).
#
# These are the PUBLIC web-app config values — identical to the fallbacks in
# lib/firebase.ts and to eas.json's production profile. They identify the
# project; they do not authorise anything. Access is controlled by
# firestore.rules and Firebase Auth.
#
# Used by `npm run build:web:prod`. Saying the target out loud in a file is
# what scripts/build-web.mjs asks for before it will build for production.

EXPO_PUBLIC_FIREBASE_PROJECT_ID=studio-2889504658-6ee2a
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBLc-jwwFrCiklo8h9UCH9dIgF2ALUQCLw
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=studio-2889504658-6ee2a.firebaseapp.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=studio-2889504658-6ee2a.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=374877124985
EXPO_PUBLIC_FIREBASE_APP_ID=1:374877124985:web:c7e928b56b265e9a2597a8

# The production website, whose API handles invitation-based registration.
EXPO_PUBLIC_SITE_URL=https://mdmaktech.sa
